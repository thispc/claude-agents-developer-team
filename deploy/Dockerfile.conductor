# Conductor image. Also contains the worker script so LAUNCHER=local works in compose.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g @anthropic-ai/claude-code \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY conductor/requirements.txt conductor/requirements.txt
COPY worker/requirements.txt worker/requirements.txt
RUN pip install --no-cache-dir -r conductor/requirements.txt -r worker/requirements.txt

COPY conductor/ conductor/
COPY worker/ worker/
COPY agents/ agents/
COPY dashboard/ dashboard/

ARG DEVTEAM_COMMIT=""
ARG DEVTEAM_IMAGE=""
# Baked in so a container can report what it is running. The image carries no
# .git on purpose: a checkout would bring the repo's remotes and stored
# credentials into every worker's environment.
ENV DEVTEAM_COMMIT=$DEVTEAM_COMMIT \
    DEVTEAM_IMAGE=$DEVTEAM_IMAGE

# Run as a non-root user.
#
# Not a hardening nicety — a hard requirement. The Claude Agent SDK launches the
# CLI with --dangerously-skip-permissions, and the CLI REFUSES that flag for uid
# 0: "cannot be used with root/sudo privileges for security reasons". As root
# every agent call fails, so the manager never plans, recruiting silently falls
# back to the keyword heuristic, and projects error out with nothing in the UI
# explaining why. The container ran as root by default, so this affected every
# agent in the cloud.
RUN useradd --create-home --uid 10001 devteam \
    && mkdir -p /data /home/devteam/.claude \
    && chown -R devteam:devteam /app /data /home/devteam
USER devteam
ENV HOME=/home/devteam

ENV AGENTS_DIR=/app/agents \
    DASHBOARD_DIR=/app/dashboard \
    WORKER_SCRIPT=/app/worker/worker.py \
    WORKSPACES_DIR=/data/workspaces \
    DB_PATH=/data/devteam.db \
    PYTHONPATH=/app/conductor

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
