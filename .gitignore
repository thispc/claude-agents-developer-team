.DS_Store

# --- v2 runtime state ---
# The store holds content-addressed artifacts; the ledger indexes into it. Both
# are runtime and both are rebuildable from contracts, so neither is source.
.store/
.cache/
# Per-run scratch: sandbox worktrees, container logs, trajectory captures.
.runs/
# Minted secrets and generated env.
.secrets/

# archive/v1 keeps its own .gitignore, which git applies relative to that
# directory — its venv, dbs, workspaces and minted tokens are covered there.
