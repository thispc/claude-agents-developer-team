# --- AI auth: set EXACTLY ONE of these two ---
# Option A: API key -> bills pay-per-token API credit (clean scaling, k8s-friendly)
ANTHROPIC_API_KEY=sk-ant-...
# Option B: Claude Pro/Max subscription -> run `claude setup-token`, paste result here.
# No extra cost, but all agents share your subscription rate limits.
#CLAUDE_CODE_OAUTH_TOKEN=
LEAD_MODEL=claude-sonnet-5
WORKER_MODEL=claude-haiku-4-5
ESCALATION_MODEL=claude-sonnet-5

# --- GitHub (fine-grained PAT with Contents:RW, Issues:RW, Pull requests:RW on the target repo) ---
GITHUB_TOKEN=github_pat_...
# Default repo used when a project doesn't specify one, format: owner/name
GITHUB_REPO=

# --- Root superuser (seeded on first run; its GitHub/API creds come from this file) ---
ROOT_USERNAME=root
ROOT_PASSWORD=change-me

# --- Conductor ---
CONDUCTOR_URL=http://localhost:8000
WORKER_TOKEN=change-me-shared-secret
DB_PATH=devteam.db

# --- Worker launching: "local" (subprocesses, for dev) or "k8s" (Jobs on DOKS) ---
LAUNCHER=local
WORKER_IMAGE=registry.digitalocean.com/YOUR_REGISTRY/devteam-worker:latest
K8S_NAMESPACE=devteam

# --- Safety rails ---
MAX_CONCURRENT_WORKERS=3
WORKER_MAX_TURNS=120
LEAD_MAX_TURNS=120
PROJECT_BUDGET_USD=5.0

# --- agent credentials (one of these; the API key wins and bills real money) ---
# CLAUDE_CODE_OAUTH_TOKEN=       # `claude setup-token` — runs on a Pro/Max plan
# (ANTHROPIC_API_KEY is above.) With neither, the host's `claude` CLI login is used.

# --- limits ---
MAX_AGENT_RUNS=40                # THE primary rail: agent runs per project.
                                 # The dollar budget is inert on a subscription.
WORKER_MAX_TURNS_RETRY=180       # turn cap on a retry after a turn-limit death
WORKER_STUCK_SECONDS=1800        # no activity for this long => failed and retried

# --- deploying a project's app ---
APPS_DOMAIN=                     # wildcard domain, e.g. apps.example.com, so apps
                                 # share ONE ingress load balancer instead of one
                                 # each (a DO load balancer is $12/month EACH).
                                 # Blank falls back to a LoadBalancer per app.
DEPLOY_REGISTRY=                 # e.g. registry.digitalocean.com/yourreg. Required
                                 # for a managed cluster; a local kind cluster is
                                 # handed the image directly and needs none.
DEPLOY_PLATFORM=linux/amd64      # cloud nodes are amd64; an ARM Mac would
                                 # otherwise build images that die with
                                 # "exec format error". Only used when pushing.
# DEPLOY_PORT_START=8600         # first port used by local app deployments
# DEPLOY_BUILD_TIMEOUT=600
# DEPLOY_BOOT_TIMEOUT=90

# --- the platform working on itself ---
SELF_REPO=                       # blank = derive from this repo's git remote

# --- paths (defaults are relative to the repo root) ---
# PREVIEW_DIR=
# DEPLOY_DIR=
