{
  "name": "render-forecast",
  "version": 1,
  "summary": "Turn a canonical forecast and its advice into a page.",
  "operations": {
    "page": {
      "in": {
        "type": "object",
        "required": [
          "forecast"
        ],
        "additionalProperties": false,
        "properties": {
          "forecast": {
            "type": "object",
            "required": [
              "days"
            ],
            "additionalProperties": true,
            "properties": {
              "place": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              },
              "days": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "highC": {
                      "type": "number"
                    },
                    "lowC": {
                      "type": "number"
                    },
                    "precipMm": {
                      "type": "number"
                    },
                    "sky": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "advice": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "query": {
            "type": "string",
            "description": "what the person typed, to prefill the search box. The form lives here rather than being wrapped around this page by the shell, because the shell has no tests and this module does."
          },
          "error": {
            "type": "string",
            "description": "a message to show instead of days \u2014 a place that was not found is a normal outcome, not a crash"
          }
        }
      },
      "out": {
        "type": "object",
        "required": [
          "html",
          "days"
        ],
        "additionalProperties": false,
        "properties": {
          "html": {
            "type": "string",
            "description": "a complete self-contained document \u2014 no external stylesheet, script or font"
          },
          "days": {
            "type": "integer"
          }
        }
      },
      "errors": [
        "EBADINPUT"
      ]
    }
  }
}
