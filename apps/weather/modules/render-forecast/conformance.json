{
  "timeoutMs": 10000,
  "cases": [
    {
      "name": "a two-day forecast renders both days",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "London",
            "lat": 51.5,
            "lon": -0.12
          },
          "days": [
            {
              "date": "2026-08-09",
              "highC": 22,
              "lowC": 14,
              "precipMm": 3.2,
              "sky": "rain"
            },
            {
              "date": "2026-08-10",
              "highC": 27,
              "lowC": 15,
              "precipMm": 0,
              "sky": "clear"
            }
          ]
        }
      },
      "expect": {
        "days": 2
      },
      "expectContains": {
        "html": [
          "London",
          "2026-08-09",
          "22\u00b0",
          "14\u00b0",
          "3.2mm",
          "rain",
          "clear"
        ]
      }
    },
    {
      "name": "one complete self-contained document, with nothing fetched from anywhere",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "X"
          },
          "days": []
        }
      },
      "expectContains": {
        "html": [
          "<!doctype html>",
          "<style>",
          "</html>"
        ]
      },
      "expectNotContains": {
        "html": [
          "<link",
          "src=\"http",
          "href=\"http",
          "@import"
        ]
      }
    },
    {
      "name": "the advice is shown when it is given",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "X"
          },
          "days": [
            {
              "date": "d",
              "highC": 18,
              "lowC": 12,
              "precipMm": 2,
              "sky": "rain"
            }
          ]
        },
        "advice": {
          "items": [
            "an umbrella"
          ],
          "summary": "Today: 12\u00b0 to 18\u00b0. Take an umbrella."
        }
      },
      "expectContains": {
        "html": [
          "Take an umbrella",
          "an umbrella"
        ]
      }
    },
    {
      "name": "a place named like a script tag renders as its own name",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "<script>alert(1)</script>"
          },
          "days": []
        }
      },
      "expectContains": {
        "html": [
          "&lt;script&gt;alert(1)&lt;/script&gt;"
        ]
      },
      "expectNotContains": {
        "html": [
          "<script>alert(1)</script>"
        ]
      }
    },
    {
      "name": "a quote in a place name cannot break out of the title",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "\" onload=\"alert(1)"
          },
          "days": []
        }
      },
      "expectNotContains": {
        "html": [
          "\" onload=\"alert(1)"
        ]
      }
    },
    {
      "name": "a missing temperature renders as a dash, not as NaN or undefined",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "X"
          },
          "days": [
            {
              "date": "d",
              "sky": "cloud"
            }
          ]
        }
      },
      "expect": {
        "days": 1
      },
      "expectNotContains": {
        "html": [
          "NaN",
          "undefined",
          "null"
        ]
      }
    },
    {
      "name": "an unrecognised sky still renders a row rather than an empty one",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "X"
          },
          "days": [
            {
              "date": "d",
              "highC": 1,
              "lowC": 0,
              "precipMm": 0,
              "sky": "banana"
            }
          ]
        }
      },
      "expect": {
        "days": 1
      },
      "expectContains": {
        "html": [
          "banana"
        ]
      }
    },
    {
      "name": "an empty forecast says so rather than rendering a blank page",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "X"
          },
          "days": []
        }
      },
      "expect": {
        "days": 0
      },
      "expectContains": {
        "html": [
          "No days in this forecast"
        ]
      }
    },
    {
      "name": "no forecast at all is refused",
      "op": "page",
      "in": {},
      "expectError": "EBADINPUT"
    },
    {
      "name": "the page carries a search box, prefilled with what was typed",
      "op": "page",
      "in": {
        "query": "Tokyo",
        "forecast": {
          "place": {
            "name": "Tokyo"
          },
          "days": []
        }
      },
      "expectContains": {
        "html": [
          "<form",
          "name=\"q\"",
          "value=\"Tokyo\"",
          "Look up"
        ]
      }
    },
    {
      "name": "the search box is a plain GET form, so the page works with scripting off and the URL is shareable",
      "op": "page",
      "in": {
        "forecast": {
          "place": {
            "name": "X"
          },
          "days": []
        }
      },
      "expectContains": {
        "html": [
          "method=\"get\""
        ]
      },
      "expectNotContains": {
        "html": [
          "<script",
          "onclick",
          "fetch("
        ]
      }
    },
    {
      "name": "a place that was not found shows the reason instead of an empty forecast",
      "op": "page",
      "in": {
        "query": "Narnia",
        "error": "no such place: Narnia",
        "forecast": {
          "place": {},
          "days": []
        }
      },
      "expectContains": {
        "html": [
          "no such place: Narnia"
        ]
      },
      "expectNotContains": {
        "html": [
          "No days in this forecast"
        ]
      }
    },
    {
      "name": "an error message is escaped like everything else",
      "op": "page",
      "in": {
        "error": "<script>alert(1)</script>",
        "forecast": {
          "place": {},
          "days": []
        }
      },
      "expectNotContains": {
        "html": [
          "<script>alert(1)</script>"
        ]
      }
    }
  ]
}
