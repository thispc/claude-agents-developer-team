          },
          {
            "id": "b",
            "status": "live",
            "evidence": [
              {
                "file": "w.toml",
                "line": 5
              }
            ]
          }
        ],
        "edges": [
          {
            "from": "a",
            "to": "b",
            "why": "\" onmouseover=\"alert(1)"
          }
        ]
      },
      "expectNotContains": {
        "html": [
          "\" onmouseover=\"alert(1)"
        ]
      }
    },
    {
