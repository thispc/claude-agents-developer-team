{
  "_note": "Stated as data, so nothing here names a language. `expect` pins the structured facts exactly; `expectContains` / `expectNotContains` pin what must and must not appear in the rendered text \u2014 which is the only form an escaping claim can take.",
  "timeoutMs": 10000,
  "cases": [
    {
      "name": "counts the states it was given",
      "op": "page",
      "in": {
        "title": "devteam",
        "nodes": [
          {
            "id": "alpha",
            "status": "live",
            "evidence": [
              {
                "file": "wiring.toml",
                "line": 3
              }
            ]
          },
          {
            "id": "beta",
            "status": "refused",
            "evidence": [
              {
                "file": "wiring.toml",
                "line": 7
              }
            ]
          },
          {
            "id": "gamma",
            "status": "unbuilt",
            "evidence": [
              {
                "file": "wiring.toml",
                "line": 11
              }
            ]
          }
        ],
        "edges": [
          {
            "from": "alpha",
            "to": "beta"
          }
        ],
        "dropped": []
      },
      "expect": {
        "stats": {
          "nodes": 3,
          "live": 1,
          "refused": 1,
          "unbuilt": 1,
          "edges": 1,
          "dropped": 0
        }
      }
    },
    {
      "name": "produces one complete self-contained document, with no external stylesheet, script or font",
      "op": "page",
      "in": {
        "nodes": [
          {
            "id": "alpha",
            "status": "live",
            "evidence": [
              {
                "file": "w.toml",
                "line": 1
              }
            ]
          }
        ]
      },
      "expectContains": {
        "html": [
          "<!doctype html>",
          "<style>",
          "</html>"
        ]
      },
      "expectNotContains": {
        "html": [
          "<link",
          "src=\"http",
          "href=\"http",
          "@import"
        ]
      }
    },
    {
      "name": "a module named like a script tag renders as its own name",
      "op": "page",
      "in": {
        "nodes": [
          {
            "id": "x",
            "label": "<script>alert(1)</script>",
            "status": "live",
            "evidence": [
              {
                "file": "w.toml",
                "line": 1
              }
            ]
          }
        ]
      },
      "expectContains": {
        "html": [
          "&lt;script&gt;alert(1)&lt;/script&gt;"
        ]
      },
      "expectNotContains": {
        "html": [
          "<script>alert(1)</script>"
        ]
      }
    },
    {
      "name": "an image-onerror payload in a note is escaped too, not only in the name",
      "op": "page",
      "in": {
        "nodes": [
          {
            "id": "x",
            "status": "live",
            "note": "<img src=x onerror=alert(1)>",
            "evidence": [
              {
                "file": "w.toml",
                "line": 1
              }
            ]
          }
        ]
      },
      "expectNotContains": {
        "html": [
          "<img src=x onerror=alert(1)>"
        ]
      },
      "expectContains": {
        "html": [
          "&lt;img src=x onerror=alert(1)&gt;"
        ]
      }
    },
    {
      "name": "a quote in an edge reason cannot break out of an attribute",
      "op": "page",
      "in": {
        "nodes": [
          {
            "id": "a",
            "status": "live",
            "evidence": [
              {
                "file": "w.toml",
                "line": 1
              }
