    "/notices": {
      "get": {
        "summary": "List Notices",
        "description": "What the logs add up to \u2014 plus the two things the conductor needs to\nfinish the list on its own side.\n\n`decisions` and `auto` ride along deliberately. The conductor merges two\nLOCAL rules into this list and has to know which of THOSE fingerprints the\nowner already dismissed; a second round-trip for that would double the cost\nof the panel's poll for one small map.",
        "operationId": "list_notices_notices_get",
        "parameters": [
          {
            "name": "window_s",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 31622400,
              "minimum": 0,
              "default": 0,
              "title": "Window S"
            }
          },
          {
            "name": "include_decided",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Decided"
            }
          },
          {
            "name": "x-service-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Notices Notices Get"
