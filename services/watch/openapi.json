  "components": {
    "schemas": {
      "AutoBody": {
        "properties": {
          "on": {
            "type": "boolean",
            "title": "On"
          }
        },
        "type": "object",
        "required": [
          "on"
        ],
        "title": "AutoBody"
      },
      "DecideBody": {
        "properties": {
          "state": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "State"
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "title": "DecideBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogRow": {
        "properties": {
          "ts": {
            "type": "number",
            "maximum": 100000000000.0,
            "minimum": 0.0,
            "title": "Ts",
            "default": 0.0
          },
          "level": {
            "type": "string",
            "maxLength": 16,
            "title": "Level",
            "default": "info"
          },
          "cat": {
            "type": "string",
            "maxLength": 32,
            "title": "Cat",
            "default": "lifecycle"
          },
          "event": {
            "type": "string",
            "maxLength": 60,
            "title": "Event",
            "default": ""
          },
          "msg": {
            "type": "string",
            "maxLength": 600,
            "title": "Msg",
            "default": ""
          },
          "dedupe_s": {
            "type": "number",
            "maximum": 86400.0,
            "minimum": 0.0,
            "title": "Dedupe S",
            "default": 0.0
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "LogRow",
        "description": "One fact.\n\nThe six named fields are typed exactly as strictly as every other body in the\nfleet. Everything ELSE the caller sends rides along untyped \u2014 `sha`, `holder`,\n`files`, `n` \u2014 because that is the whole shape of a log row, and a logger that\ncould only say the six things this schema names would be no logger at all.\nThose extras are coerced and truncated on the way into the table, so a caller\ninside an exception handler passing `n=\"3\"` where an int was meant still gets\nits line on the record. Losing the evidence about a failure is worse than\nstoring a string.\n\n`level` and `cat` are plain strings here rather than enums on purpose: an\nunknown one is CORRECTED to a known value (see `_split`), never refused. A\n422 on a typo'd category would drop the row, and the row is the point."
      },
      "LogsBody": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/LogRow"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Rows"
          }
        },
        "type": "object",
        "title": "LogsBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
