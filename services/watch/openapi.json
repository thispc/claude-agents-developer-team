    "/logs": {
      "post": {
        "summary": "Logs Route",
        "description": "Record a BATCH of rows. Batch, not row: the client is on the platform's\nhottest path (64 call sites, some inside exception handlers, some in a 20s\ntick) and it may never pay a round-trip per line.",
        "operationId": "logs_route_logs_post",
