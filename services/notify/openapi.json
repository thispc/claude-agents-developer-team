  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Kind"
          },
          "detail": {
            "type": "string",
            "maxLength": 20000,
            "title": "Detail",
            "default": ""
          },
          "context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          },
          "repo": {
            "type": "string",
            "maxLength": 200,
            "title": "Repo",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "ErrorBody"
      },
      "ForgetBody": {
        "properties": {
          "fingerprint": {
            "type": "string",
            "maxLength": 64,
            "title": "Fingerprint",
            "default": ""
          }
        },
        "type": "object",
        "title": "ForgetBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IssueBody": {
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Repo"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 20000,
            "title": "Body",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "repo",
          "title"
        ],
        "title": "IssueBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
